# =============================================================================
# Maths DD Backend — Environment Configuration Template
# Copy this file to `.env` for local development. Never commit `.env`!
# =============================================================================

PROJECT_NAME="Maths DD API"
API_VERSION="1.0.0"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8080

# Comma-separated allowed CORS origins (or * for development)
CORS_ORIGINS="*"

# PostgreSQL / Google Cloud SQL Configuration
DB_USER="postgres"
DB_PASSWORD=""
DB_NAME="math-master-981fe-database"
DB_HOST="127.0.0.1"
DB_PORT=5432
INSTANCE_CONNECTION_NAME=""
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Firebase Admin & Cloud Storage Configuration
FIREBASE_PROJECT_ID="math-master-981fe"
GOOGLE_APPLICATION_CREDENTIALS=""
STORAGE_BUCKET_NAME="math-master-981fe.firebasestorage.app"
