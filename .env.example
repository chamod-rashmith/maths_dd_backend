# =============================================================================
# Maths DD Backend — Google Cloud Run Environment Template
# =============================================================================

PROJECT_NAME="Maths DD API"
API_VERSION="1.0.0"
ENVIRONMENT="production"
HOST="0.0.0.0"
PORT=8080

# Comma-separated allowed CORS origins (or * for all)
CORS_ORIGINS="*"

# Google Cloud SQL (PostgreSQL via Cloud Run Unix Domain Socket)
DB_USER="postgres"
DB_PASSWORD=""
DB_NAME="math-master-981fe-database"
INSTANCE_CONNECTION_NAME="math-master-981fe:asia-south1:math-master-981fe-instance"
DB_SOCKET_DIR="/cloudsql"
DB_HOST=""
DB_PORT=5432
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Firebase Admin & Google Cloud Storage Configuration
FIREBASE_PROJECT_ID="math-master-981fe"
GOOGLE_APPLICATION_CREDENTIALS=""
STORAGE_BUCKET_NAME="math-master-981fe.firebasestorage.app"

# Upstash Serverless Redis Cache
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
